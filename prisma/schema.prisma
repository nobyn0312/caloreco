generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// アプリ実行用（Supabase transaction pooler / 6543 を推奨）
  url       = env("DATABASE_URL")
  /// migrate 用（Supabase session pooler / 5432 または Direct）
  directUrl = env("DIRECT_URL")
}

model Memo {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    String
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  /// Google ログイン時は null（パスワード未設定）
  passwordHash   String?
  email          String?   @unique
  googleId       String?   @unique
  /// Google 初回ログイン時は未設定のまま。目標提案前に /account で埋める想定
  age            Int?
  gender         String?
  heightCm       Float?
  weightKg       Float?
  /// AI が後から設定する目標 PFC（g/日）。現状は null
  targetProteinG Float?
  targetFatG     Float?
  targetCarbsG   Float?
  targetKcal     Float?
  pfcSetAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  targetWeightKg Float?
  bodyGoal       String?
  activityLevel  String?
  mealLogs       MealLog[]
}

model MealLog {
  id        Int      @id @default(autoincrement())
  rawInput  String
  result    Json
  createdAt DateTime @default(now())
  totalKcal Float?
  totalP    Float?
  totalF    Float?
  totalC    Float?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}
